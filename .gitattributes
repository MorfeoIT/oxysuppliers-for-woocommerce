# What `git archive` leaves out is what the distributed plugin does not carry.
# Keeping this list here means the package is built from the repository rather
# than assembled by hand, so it cannot drift from what was tested.

/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.wordpress-org     export-ignore
/docs               export-ignore
/tests              export-ignore
/scripts            export-ignore
/composer.json      export-ignore
/composer.lock      export-ignore
/phpcs.xml.dist     export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
/CHANGELOG.md       export-ignore
/README.md          export-ignore
