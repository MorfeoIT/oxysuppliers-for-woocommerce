#. Plugin Name of the plugin
#: oxysuppliers-for-woocommerce.php
msgid "OxySuppliers – Suppliers & Purchase Orders for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: oxysuppliers-for-woocommerce.php
msgid "https://oxywp.com/plugins/oxysuppliers-for-woocommerce/"
msgstr ""

#. Description of the plugin
#: oxysuppliers-for-woocommerce.php
msgid "Know what to reorder, from which supplier and how much. Suppliers, purchase orders, goods receipts and stock updates, inside WooCommerce."
msgstr "Sai cosa riordinare, da quale fornitore e quanto. Fornitori, ordini di acquisto, ricezioni merce e giacenze aggiornate, dentro WooCommerce."

#. Author of the plugin
#: oxysuppliers-for-woocommerce.php
msgid "Oxysoft"
msgstr ""

#. Author URI of the plugin
#: oxysuppliers-for-woocommerce.php
msgid "https://oxysoft.it/"
msgstr ""

#: oxysuppliers-for-woocommerce.php:169
msgid "OxySuppliers needs PHP 8.1 or later and WooCommerce 9.0 or later."
msgstr "OxySuppliers ha bisogno di PHP 8.1 o successivo e WooCommerce 9.0 o successivo."

#: oxysuppliers-for-woocommerce.php:170
msgid "OxySuppliers needs WooCommerce to be installed and active."
msgstr "OxySuppliers ha bisogno che WooCommerce sia installato e attivo."

#: src/Admin/ImportScreen.php:70
msgid "Import"
msgstr "Importazione"

#: src/Admin/ImportScreen.php:99
#: src/Admin/ImportScreen.php:277
#: src/Admin/ImportScreen.php:353
msgid "You are not allowed to import suppliers."
msgstr "Non hai il permesso di importare fornitori."

#: src/Admin/ImportScreen.php:122
msgid "Import a price list"
msgstr "Importa un listino"

#: src/Admin/ImportScreen.php:125
msgid "A CSV file with one row per article a supplier sells you. Nothing is changed until you have seen what it would do."
msgstr "Un file CSV con una riga per ogni articolo che un fornitore ti vende. Non viene cambiato niente finché non hai visto cosa farebbe."

#: src/Admin/ImportScreen.php:131
msgid "Column"
msgstr "Colonna"

#: src/Admin/ImportScreen.php:132
msgid "What it is"
msgstr "Cos'è"

#: src/Admin/ImportScreen.php:136
msgid "The supplier's name. Required."
msgstr "Il nome del fornitore. Obbligatorio."

#: src/Admin/ImportScreen.php:137
msgid "Your own SKU, as WooCommerce knows it. Required."
msgstr "Il tuo SKU, come lo conosce WooCommerce. Obbligatorio."

#: src/Admin/ImportScreen.php:138
msgid "Their VAT number. Used to recognise a supplier you already have."
msgstr "La sua partita IVA. Serve a riconoscere un fornitore che hai già."

#: src/Admin/ImportScreen.php:139
msgid "Where their orders should go."
msgstr "Dove vanno mandati i suoi ordini."

#: src/Admin/ImportScreen.php:140
msgid "Their code for the article, which is what goes on the order."
msgstr "Il suo codice per l'articolo, che è quello che finisce sull'ordine."

#: src/Admin/ImportScreen.php:141
msgid "What they charge. A comma or a full stop, either way."
msgstr "Quanto fa pagare. Con la virgola o con il punto, va bene lo stesso."

#: src/Admin/ImportScreen.php:142
msgid "Their buying terms, as whole numbers."
msgstr "Le sue condizioni di acquisto, in numeri interi."

#: src/Admin/ImportScreen.php:147
msgid "Italian headings work too, and so do semicolons instead of commas: a file saved by a spreadsheet is still a file."
msgstr "Vanno bene anche le intestazioni in italiano, e i punti e virgola al posto delle virgole: un file salvato da un foglio di calcolo resta un file."

#: src/Admin/ImportScreen.php:159
msgid "Read the file"
msgstr "Leggi il file"

#: src/Admin/ImportScreen.php:187
msgid "What this would do"
msgstr "Cosa farebbe"

