{
    "name": "oxysoft/oxysuppliers-for-woocommerce",
    "description": "Suppliers, purchase orders and goods receipts for WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-phpunit/wp-phpunit": "^6.5",
        "roots/wordpress": "^7.0",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.2",
        "php-stubs/wordpress-stubs": "^6.5",
        "php-stubs/woocommerce-stubs": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Oxysoft\\OxySuppliers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oxysoft\\OxySuppliers\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:all": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "wordpress-install-dir": "wordpress"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true,
            "roots/wordpress-core-installer": true
        },
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
